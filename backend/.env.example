# ---------------------------------------------------------------------------
# CampusHub backend — environment variables
# Copy this file to `.env` in the backend/ folder and fill in real values:
#     cp .env.example .env
# ---------------------------------------------------------------------------

# HTTP port the Express server listens on
PORT=5000

# Local MySQL instance
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campushub

# JWT signing secret — use a long random string in your real .env
JWT_SECRET=change_this_to_a_long_random_string

# ---------------------------------------------------------------------------
# Amazon S3 image storage (used on the AWS deployment)
# When S3_BUCKET_NAME is set, uploaded images stream to S3 through the AWS SDK
# and items.image_url stores the S3 object URL. Credentials resolve via the EC2
# instance role (default provider chain); the keys below are the SDK's fallback
# for environments without a role. Leave S3_BUCKET_NAME empty for local
# development — images are then written to backend/uploads/ and served from
# /uploads, with nothing sent to AWS.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
